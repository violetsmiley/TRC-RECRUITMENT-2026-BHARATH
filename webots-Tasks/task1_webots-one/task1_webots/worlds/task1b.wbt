#VRML_SIM R2025a utf8

# Task 1b - Line follower.
# Built from Webots base nodes only: there are no external PROTO declarations,
# so nothing is downloaded or looked up in the Webots installation folder.
#
# The line is a chain of near-black box segments sitting 1.5 mm above the floor
# (just enough to avoid z-fighting - the height is NOT how it is detected).
#
# Detection is by REFLECTANCE. A Webots infra-red DistanceSensor divides the
# measured distance by  f = 0.2 + 0.8 * red * (1 - 0.5 * roughness)  before the
# lookup table, so at the same 18 mm height the near-black line reports about
# 77 mm while the white floor reports about 22 mm. The lookup table below spans
# 0 .. 0.12 m to cover both; a table sized for the raw 18 mm gap would read 0
# over BOTH surfaces and the robot would be blind.

WorldInfo {
  info [
    "Task 1b - Line follower"
    "Robot is the Task 1a chassis (0.30 x 0.15 x 0.05 m) plus 3 IR ground sensors."
    "Press PLAY - the robot follows the loop on its own."
  ]
  title "Task 1b - Line Follower"
  basicTimeStep 16
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "default"
      coulombFriction [
        1.5
      ]
      softCFM 0.0001
    }
  ]
}
Viewpoint {
  orientation 1 0 0 0.8887
  position 0 -3.2 2.6
}
Background {
  skyColor [
    0.21 0.27 0.36
  ]
}
DirectionalLight {
  ambientIntensity 0.55
  direction -0.6 -0.5 -1
  intensity 2.5
  castShadows TRUE
}
DirectionalLight {
  ambientIntensity 0.3
  direction 0.7 0.5 -0.6
  intensity 1.2
}
# ---------------- floor : 4 x 4 m, bright, top surface exactly at z = 0 -------
Solid {
  translation 0 0 -0.01
  children [
    DEF FLOOR Shape {
      appearance PBRAppearance {
        baseColor 0.93 0.93 0.94
        roughness 0.3
        metalness 0
      }
      geometry Box {
        size 4 4 0.02
      }
    }
  ]
  name "floor"
  boundingObject USE FLOOR
}
# ---------------- arena walls ----------------
Solid {
  translation 0 2.01 0.06
  children [
    DEF WALL Shape {
      appearance PBRAppearance {
        baseColor 0.38 0.41 0.47
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 4.04 0.02 0.12
      }
    }
  ]
  name "wall_north"
  boundingObject USE WALL
}
Solid {
  translation 0 -2.01 0.06
  children [
    USE WALL
  ]
  name "wall_south"
  boundingObject USE WALL
}
Solid {
  translation 2.01 0 0.06
  rotation 0 0 1 1.5708
  children [
    USE WALL
  ]
  name "wall_east"
  boundingObject USE WALL
}
Solid {
  translation -2.01 0 0.06
  rotation 0 0 1 1.5708
  children [
    USE WALL
  ]
  name "wall_west"
  boundingObject USE WALL
}
