# ============================== the robot ==============================
# Identical chassis and drivetrain to Task 1a, with a three-sensor IR rig
# added under the nose.
DEF TASK1B_ROBOT Robot {
  translation 1.2000 0.0000 0.0500
  rotation 0 0 1 1.570796
  children [
    # ---------------- chassis : 0.3 (l) x 0.15 (b) x 0.05 (h) metres ----------
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.18 0.45 0.85
        roughness 0.4
        metalness 0.1
      }
      geometry Box {
        size 0.3 0.15 0.05
      }
    }
    # ---------------- three downward infra-red ground sensors ----------------
    # Nothing is modelled below the chassis here on purpose: infra-red rays
    # collide with the Solid geometry itself, the robot's own included, so a
    # decorative sensor mount would sit in front of the beams.
    # rotation 0 1 0 1.5708 turns the sensor's +x ray to point straight down.
    DistanceSensor {
      translation 0.1200 0.0250 -0.0320
      rotation 0 1 0 1.5708
      name "ir_left"
      lookupTable [
        0 1000 0
        0.120 0 0
      ]
      type "infra-red"
      numberOfRays 7
      aperture 1.0
      resolution -1
    }
    DistanceSensor {
      translation 0.1200 0 -0.0320
      rotation 0 1 0 1.5708
      name "ir_center"
      lookupTable [
        0 1000 0
        0.120 0 0
      ]
      type "infra-red"
      numberOfRays 7
      aperture 1.0
      resolution -1
    }
    DistanceSensor {
      translation 0.1200 -0.0250 -0.0320
      rotation 0 1 0 1.5708
      name "ir_right"
      lookupTable [
        0 1000 0
        0.120 0 0
      ]
      type "infra-red"
      numberOfRays 7
      aperture 1.0
      resolution -1
    }
    # ---------------- front-left wheel ----------------
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.1 0.09 0
      }
      device [
        RotationalMotor {
          name "wheel_fl"
          maxVelocity 20
        }
        PositionSensor {
          name "enc_fl"
        }
      ]
      endPoint Solid {
        translation 0.1 0.09 0
        children [
          DEF WHEEL Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.12
              roughness 1
              metalness 0
            }
            geometry Cylinder {
              height 0.03
              radius 0.05
              subdivision 36
            }
          }
        ]
        name "wheel_fl_solid"
        contactMaterial "wheel"
        boundingObject USE WHEEL
        physics DEF WHEEL_PHYSICS Physics {
          density -1
          mass 0.1
        }
      }
    }
    # ---------------- front-right wheel ----------------
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.1 -0.09 0
      }
      device [
        RotationalMotor {
          name "wheel_fr"
          maxVelocity 20
        }
        PositionSensor {
          name "enc_fr"
        }
      ]
      endPoint Solid {
        translation 0.1 -0.09 0
        children [
          USE WHEEL
        ]
        name "wheel_fr_solid"
        contactMaterial "wheel"
        boundingObject USE WHEEL
        physics USE WHEEL_PHYSICS
      }
    }
    # ---------------- rear-left wheel ----------------
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.1 0.09 0
      }
      device [
        RotationalMotor {
          name "wheel_rl"
          maxVelocity 20
        }
        PositionSensor {
          name "enc_rl"
        }
      ]
      endPoint Solid {
        translation -0.1 0.09 0
        children [
          USE WHEEL
        ]
        name "wheel_rl_solid"
        contactMaterial "wheel"
        boundingObject USE WHEEL
        physics USE WHEEL_PHYSICS
      }
    }
    # ---------------- rear-right wheel ----------------
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.1 -0.09 0
      }
      device [
        RotationalMotor {
          name "wheel_rr"
          maxVelocity 20
        }
        PositionSensor {
          name "enc_rr"
        }
      ]
      endPoint Solid {
        translation -0.1 -0.09 0
        children [
          USE WHEEL
        ]
        name "wheel_rr_solid"
        contactMaterial "wheel"
        boundingObject USE WHEEL
        physics USE WHEEL_PHYSICS
      }
    }
  ]
  name "task1b_robot"
  boundingObject USE BODY
  physics Physics {
    density -1
    mass 1.5
    centerOfMass [
      0 0 -0.02
    ]
  }
  controller "line_follower"
}
